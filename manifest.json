{
  "manifest_version": 3,
  "name": "Walmart Category Collector",
  "version": "0.4.0",
  "description": "Collect all products in a Walmart search/category (every page) into a clean Excel with embedded thumbnails, one click. Excludes recommended/related carousels.",
  "permissions": ["storage", "downloads", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.walmart.com/*",
    "https://*.walmartimages.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Walmart Category Collector" },
  "content_scripts": [
    {
      "matches": [
        "https://www.walmart.com/browse/*",
        "https://www.walmart.com/search*",
        "https://www.walmart.com/shop/*",
        "https://www.walmart.com/cp/*",
        "https://www.walmart.com/c/*"
      ],
      "js": ["xlsx.full.min.js", "exceljs.min.js", "pipeline.js", "excel.js", "sites.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
