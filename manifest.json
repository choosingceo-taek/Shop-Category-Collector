{
  "manifest_version": 3,
  "name": "Shop Category Collector",
  "version": "1.17.0",
  "description": "Collect every product in a filtered category/search (every page) into a clean Excel with embedded thumbnails, one click. Full detail (fabric/colorway/design) on Walmart; basic fields (name/price/image/URL) on other allow-listed sites. Excludes recommended/related carousels.",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://www.walmart.com/*",
    "https://*.walmartimages.com/*",
    "https://www.target.com/*",
    "https://target.scene7.com/*",
    "https://www.zara.com/*",
    "https://static.zara.net/*",
    "https://www.cos.com/*",
    "https://cos.com/*",
    "https://www.massimodutti.com/*",
    "https://massimodutti.com/*",
    "https://static.massimodutti.net/*",
    "https://edikted.co.uk/*",
    "https://www.edikted.co.uk/*",
    "https://edikted.com/*",
    "https://www.edikted.com/*",
    "https://*.shopify.com/*",
    "https://cottonon.com/*",
    "https://www.cottonon.com/*",
    "https://*.cottonon.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shop Category Collector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.walmart.com/browse/*",
        "https://www.walmart.com/search*",
        "https://www.walmart.com/shop/*",
        "https://www.walmart.com/cp/*",
        "https://www.walmart.com/c/*",
        "https://www.target.com/c/*",
        "https://www.target.com/s*",
        "https://www.target.com/b/*",
        "https://www.zara.com/*",
        "https://www.cos.com/*",
        "https://cos.com/*",
        "https://www.massimodutti.com/*",
        "https://massimodutti.com/*",
        "https://edikted.co.uk/*",
        "https://www.edikted.co.uk/*",
        "https://edikted.com/*",
        "https://www.edikted.com/*",
        "https://cottonon.com/*",
        "https://www.cottonon.com/*",
        "https://*.cottonon.com/*"
      ],
      "js": ["exceljs.min.js", "excel.js", "sites.js", "content.js", "fab.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.massimodutti.com/*",
        "https://massimodutti.com/*"
      ],
      "js": ["md-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
