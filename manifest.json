{
  "manifest_version": 3,
  "name": "Market Lens",
  "version": "1.38.0",
  "description": "참고할 브랜드 카테고리 URL을 리스트로 모으고, 그 리스트를 스캔해 브랜드·카테고리·상품명·썸네일·URL·원단·혼용률을 Excel로 뽑는 마켓 리서치 도구.",
  "permissions": [
    "storage",
    "downloads",
    "sidePanel",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "https://www.walmart.com/*",
    "https://*.walmartimages.com/*",
    "https://www.target.com/*",
    "https://target.scene7.com/*",
    "https://www.zara.com/*",
    "https://static.zara.net/*",
    "https://www.aritzia.com/*",
    "https://aritzia.com/*",
    "https://*.aritzia.com/*",
    "https://www.cos.com/*",
    "https://cos.com/*",
    "https://www.massimodutti.com/*",
    "https://massimodutti.com/*",
    "https://static.massimodutti.net/*",
    "https://edikted.co.uk/*",
    "https://www.edikted.co.uk/*",
    "https://edikted.com/*",
    "https://www.edikted.com/*",
    "https://*.shopify.com/*",
    "https://cottonon.com/*",
    "https://www.cottonon.com/*",
    "https://*.cottonon.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Market Lens 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.walmart.com/browse/*",
        "https://www.walmart.com/search*",
        "https://www.walmart.com/shop/*",
        "https://www.walmart.com/cp/*",
        "https://www.walmart.com/c/*",
        "https://www.target.com/c/*",
        "https://www.target.com/s*",
        "https://www.target.com/b/*",
        "https://www.zara.com/*",
        "https://www.aritzia.com/*",
        "https://aritzia.com/*",
        "https://www.cos.com/*",
        "https://cos.com/*",
        "https://www.massimodutti.com/*",
        "https://massimodutti.com/*",
        "https://edikted.co.uk/*",
        "https://www.edikted.co.uk/*",
        "https://edikted.com/*",
        "https://www.edikted.com/*",
        "https://cottonon.com/*",
        "https://www.cottonon.com/*",
        "https://*.cottonon.com/*"
      ],
      "js": [
        "exceljs.min.js",
        "excel.js",
        "sites.js",
        "content.js",
        "fab.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.massimodutti.com/*",
        "https://massimodutti.com/*"
      ],
      "js": [
        "md-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}