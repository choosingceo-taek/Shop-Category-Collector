{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./.next/**)",
      "Read(./out/**)",
      "Read(./coverage/**)",
      "Read(./**/vendor/**)",
      "Read(./**/*.min.js)",
      "Read(./**/*.min.css)",
      "Read(./**/*.map)",
      "Read(./**/package-lock.json)",
      "Read(./**/yarn.lock)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/__pycache__/**)",
      "Read(./.venv/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}
